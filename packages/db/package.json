{
  "name": "@curiouslycory/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "push": "pnpm run migrate:sqlite && pnpm with-env drizzle-kit push",
    "push:pg": "pnpm with-env drizzle-kit push --config drizzle.pg.config.ts",
    "generate:pg": "pnpm with-env drizzle-kit generate --config drizzle.pg.config.ts",
    "migrate:pg": "pnpm with-env drizzle-kit migrate --config drizzle.pg.config.ts",
    "migrate:sqlite": "pnpm with-env node src/bin/migrate-sqlite.ts",
    "studio": "pnpm with-env drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@curiouslycory/eslint-config": "workspace:*",
    "@curiouslycory/prettier-config": "workspace:*",
    "@curiouslycory/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  },
  "prettier": "@curiouslycory/prettier-config"
}
