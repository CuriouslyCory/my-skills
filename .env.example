# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# ---------- Authentication (better-auth) ----------

# Signing secret for better-auth. You can generate one via 'openssl rand -base64 32'.
# Falls back to a hardcoded dev secret if unset (set this in production).
# Mapped to better-auth's `secret` option (we keep the AUTH_SECRET name rather
# than better-auth's default BETTER_AUTH_SECRET).
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

# Base URL of the web app, used by better-auth to build OAuth callback URLs.
# Defaults to http://localhost:3000 when unset. (better-auth calls this BETTER_AUTH_URL.)
BETTER_AUTH_URL='http://localhost:3000'

# GitHub OAuth app credentials. When BOTH are set, multi-user auth is enabled
# (email/password sign-up plus GitHub OAuth sign-in, login enforced). When either
# is unset, the app runs in local single-user mode: a single local user is
# auto-provisioned and no sign-in is required (self-hosted SQLite workflow).
# Register the OAuth app callback as: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''

# ---------- Database ----------

# Which database driver to use: 'sqlite' (default, local) or 'postgres' (Neon/Vercel).
# When unset, the app runs on local SQLite.
DB_DIALECT='sqlite'

# Path to the SQLite database file (default: ./data/my-skills.db). Used when DB_DIALECT=sqlite.
DB_PATH='./data/my-skills.db'

# PostgreSQL connection string. Required when DB_DIALECT=postgres (e.g. a Neon URL).
POSTGRES_URL=''

# ---------- Web App ----------

# Absolute path to the repository root. Used by the web app to locate skill files.
# Falls back to resolve(cwd(), "../..") if unset.
REPO_PATH=''

# ---------- CLI Overrides ----------

# Override the default cache directory used by the CLI (default: XDG cache dir)
# MY_SKILLS_CACHE_DIR=''

# Override the default skills directory used by the CLI (default: XDG data dir)
# MY_SKILLS_SKILLS_DIR=''
